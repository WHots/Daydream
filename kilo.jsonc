{
    "$schema": "https://app.kilo.ai/config.json",
    // Project rules loaded into every Kilo Code task. Without this, the agent will
    // reformat the hand-written Allman braces to rustfmt's same-line style and add
    // the #[cfg(windows)] guards CLAUDE.md forbids.
    "instructions": [
        ".kilo/rules/*.md",
        "CLAUDE.md"
    ]
}
